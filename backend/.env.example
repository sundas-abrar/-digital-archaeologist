# Copy this file to .env and fill in your key.
# Get a free Groq API key at https://console.groq.com/keys

GROQ_API_KEY=

# Optional: override the default model (openai/gpt-oss-120b)
# GROQ_MODEL=openai/gpt-oss-120b

# Only needed when deploying \u2014 comma-separated list of frontend URLs
# allowed to call this API. Localhost is always allowed automatically.
# ALLOWED_ORIGINS=https://your-app.vercel.app
