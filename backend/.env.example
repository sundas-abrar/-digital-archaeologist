# Copy this file to .env and fill in your key.
# Get a free Groq API key at https://console.groq.com/keys

GROQ_API_KEY=

# Optional: override the default model (openai/gpt-oss-120b)
# GROQ_MODEL=openai/gpt-oss-120b

# --- Deployment only (leave blank for local development) ---

# If set, every API route except /api/health requires this exact value
# in an "X-Site-Password" header. The frontend gate (frontend/middleware.ts)
# sends it automatically once someone enters it. Leave blank locally.
SITE_PASSWORD=

# Comma-separated list of extra frontend origins allowed to call this
# API (your deployed Vercel URL, custom domain, etc). localhost is
# always allowed and doesn't need to be listed here.
ALLOWED_ORIGINS=
